// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  email    String  @unique
  password String
  name     String?

  role               Role    @default(OPERATOR)
  isActive           Boolean @default(true)
  mustChangePassword Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId Int
  organization   Organization    @relation(fields: [organizationId], references: [id])
  stockMovements StockMovement[]
  sales          Sale[]
}

model Organization {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  cuit         String?
  taxCondition TaxCondition?

  // AFIP Configuration
  afipCrt       String? // Certificate Content
  afipKey       String? // Private Key Content (should be encrypted in prod)
  salesPoint    Int       @default(1)
  grossIncome   String?
  startActivity DateTime?

  users      User[]
  products   Product[]
  categories Category[]
  suppliers  Supplier[]
  movements  StockMovement[]
  clients    Client[]
  sales      Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  STAFF
  READ_ONLY
  OPERATOR
}

model Product {
  id Int @id @default(autoincrement())

  name        String
  barcode     String?
  description String?
  price       Decimal @default(0)
  cost        Decimal @default(0)
  stock       Int     @default(0)
  minStock    Int     @default(0)
  isActive    Boolean @default(true) // Soft Delete

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  movements StockMovement[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  saleItems SaleItem[]

  @@unique([organizationId, barcode]) // Barcode unique per organization
}

model Category {
  id   Int    @id @default(autoincrement())
  name String

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
}

model Supplier {
  id    Int     @id @default(autoincrement())
  name  String
  email String?
  phone String?

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
}

model StockMovement {
  id Int @id @default(autoincrement())

  type     MovementType
  quantity Int
  reason   String?

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  unitCost Decimal @default(0)

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
}

model Client {
  id           Int          @id @default(autoincrement())
  name         String
  cuit         String?
  address      String?
  email        String?
  taxCondition TaxCondition @default(CONSUMIDOR_FINAL)
  isActive     Boolean      @default(true) // Soft Delete

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, cuit])
}

model Sale {
  id Int @id @default(autoincrement())

  date  DateTime @default(now())
  total Decimal

  invoiceType   InvoiceType @default(B)
  cae           String?
  caeExpiration DateTime?
  invoiceNumber Int? // Numero de comprobante oficial de AFIP

  userId Int
  user   User @relation(fields: [userId], references: [id])

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  items SaleItem[]

  // Credit Note Relation
  relatedSaleId Int?
  relatedSale   Sale?  @relation("RelatedSale", fields: [relatedSaleId], references: [id])
  creditNotes   Sale[] @relation("RelatedSale")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  number Int @default(0) // Internal/Visual number per organization and type

  @@unique([organizationId, invoiceType, number])
}

model SaleItem {
  id Int @id @default(autoincrement())

  quantity  Int
  unitPrice Decimal

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id])
}

enum MovementType {
  IN
  OUT
  ADJUST
}

enum TaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTISTA
  CONSUMIDOR_FINAL
  EXENTO
}

enum InvoiceType {
  A
  B
  C
  X
  NCA
  NCB
  NCC
  NCX
}
